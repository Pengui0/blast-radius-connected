# --- Agent (Gemini). Without a key the agent replays recorded runs and says so in the UI.
GEMINI_API_KEY=""
# Model names change; set this to a model available to your key.
GEMINI_MODEL="gemini-3.8-flash"

# --- FalkorDB (defaults match `docker compose up -d`)
GRAPH_BACKEND="sqlite"
FALKOR_HOST="localhost"
FALKOR_PORT="6379"
FALKOR_QUERY_TIMEOUT_MS="20000"
# FalkorDB Cloud / authenticated instances only:
# FALKOR_USERNAME=""
# FALKOR_PASSWORD=""
# FALKOR_SSL="true"

# --- App
# PORT=3000          # UI + proxy
# API_PORT=8001      # FastAPI
# PYTHON_BIN=python  # interpreter used to spawn the backend (e.g. .venv/bin/python)
# SKIP_PYTHON=1      # set if you run `python -m backend.main` yourself
# AGENT_MODE=replay  # force recorded agent runs (demo insurance)
